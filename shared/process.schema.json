{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "本捏ねの工程データ（A の出力 = B の入力）",
  "type": "object",
  "required": [
    "version",
    "source_runs",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "description": "A で仕込みを追加するたびに増える"
    },
    "source_runs": {
      "type": "array",
      "description": "採集に使った仕込み",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "principles": {
      "type": "array",
      "description": "職人が定めた、全工程に通じる決まり",
      "items": {
        "type": "string"
      }
    },
    "limits": {
      "type": "object",
      "description": "職人が定めた温度の決まり",
      "required": [
        "dough_temp_below",
        "finish_temp_target"
      ],
      "additionalProperties": false,
      "properties": {
        "dough_temp_below": {
          "type": "number",
          "description": "生地温度をこの値より低く保つ"
        },
        "finish_temp_target": {
          "type": "number",
          "description": "捏ね上げ温度の目標"
        }
      }
    },
    "rescue": {
      "type": "object",
      "description": "職人が語った、失敗の原因、前兆、対処",
      "required": [
        "warn_temp",
        "cause",
        "signs",
        "sign_action",
        "check_habit",
        "actions"
      ],
      "additionalProperties": false,
      "properties": {
        "warn_temp": {
          "type": "number",
          "description": "この温度以上で対処を示す"
        },
        "cause": {
          "type": "string"
        },
        "signs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sign_action": {
          "type": "string"
        },
        "check_habit": {
          "type": "string",
          "description": "温度を測る習慣についての職人の言葉"
        },
        "actions": {
          "type": "array",
          "description": "試す順の対処",
          "items": {
            "type": "object",
            "required": [
              "text",
              "last_resort"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string"
              },
              "last_resort": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "description": "根拠となった発言。職人の確認で加えた内容には付かない",
      "required": [
        "run",
        "at_sec",
        "quote"
      ],
      "additionalProperties": false,
      "properties": {
        "run": {
          "type": "string"
        },
        "at_sec": {
          "type": "number"
        },
        "quote": {
          "type": "string"
        }
      }
    },
    "criterion": {
      "type": "object",
      "description": "次の工程へ進む基準",
      "required": [
        "kind",
        "text",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "time",
            "temperature",
            "sight",
            "touch"
          ],
          "description": "sight だけが映像の確認を使う。touch は利用者が手で確かめて答える"
        },
        "text": {
          "type": "string",
          "description": "語りに基づく基準"
        },
        "visual_question": {
          "type": "string",
          "description": "kind が sight のとき、現在の工程で映像に問う質問"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "reference_frames": {
          "type": "array",
          "description": "kind が sight のとき、語りの時点の参考映像",
          "items": {
            "type": "object",
            "required": [
              "path",
              "run",
              "at_sec",
              "quote",
              "state",
              "frame_sec"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "run": {
                "type": "string"
              },
              "at_sec": {
                "type": "number"
              },
              "quote": {
                "type": "string"
              },
              "state": {
                "enum": [
                  "good",
                  "not_yet"
                ],
                "description": "good は届いた例、not_yet はまだの例"
              },
              "frame_sec": {
                "type": "number",
                "description": "映像の時刻。at_sec は根拠の発言の時刻"
              }
            }
          }
        }
      }
    },
    "branch": {
      "type": "object",
      "description": "温度などの状況に応じた判断",
      "required": [
        "when",
        "instruction",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "when": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dough_temp_min": {
              "type": "number"
            },
            "dough_temp_max": {
              "type": "number"
            },
            "note": {
              "type": "string"
            }
          }
        },
        "instruction": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "id",
        "title",
        "instruction",
        "criteria",
        "branches"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "instruction": {
          "type": "string",
          "description": "表示し、読み上げる指示"
        },
        "duration_minutes": {
          "type": "object",
          "description": "職人が語った、この工程の所要時間の目安（分）。語られていなければ入れない",
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        },
        "time_note": {
          "type": "string",
          "description": "時間についての補足"
        },
        "ask_dough_temp": {
          "type": "boolean",
          "description": "この工程で温度の入力を求める"
        },
        "criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/criterion"
          }
        },
        "branches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/branch"
          }
        }
      }
    }
  }
}
